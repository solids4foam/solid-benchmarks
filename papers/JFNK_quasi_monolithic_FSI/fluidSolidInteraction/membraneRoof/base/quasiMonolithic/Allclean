#!/bin/bash

# Source tutorial clean functions
. "$WM_PROJECT_DIR/bin/tools/CleanFunctions"

if [[ -f "${SOLIDS4FOAM_ROOT:-}/applications/scripts/solids4FoamScripts.sh" ]]
then
    source "${SOLIDS4FOAM_ROOT}/applications/scripts/solids4FoamScripts.sh"
else
    source solids4FoamScripts.sh
fi

cleanCase

if [[ $WM_PROJECT = "foam" ]]
then
    foamClearPolyMesh -region fluid
    foamClearPolyMesh -region solid
elif [[ $WM_PROJECT_VERSION == v* ]]
then
    foamCleanPolyMesh -region fluid
    foamCleanPolyMesh -region solid
fi

rm -rf case.foam residuals force.pdf deflection.pdf iterations.pdf postProcessing
find ./0 ./constant ./system -maxdepth 3 -type l -exec rm -f {} \; 2>/dev/null
