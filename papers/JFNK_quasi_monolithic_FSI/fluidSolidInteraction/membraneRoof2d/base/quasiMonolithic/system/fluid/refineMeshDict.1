FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      refineMeshDict.1;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

set cellsToRefine1;

coordinateSystem global;

globalCoeffs
{
    tan1 (1 0 0);
    tan2 (0 1 0);
}

directions
(
    tan1
    tan2
);

useHexTopology  false;

geometricCut    false;

writeMesh       false;

