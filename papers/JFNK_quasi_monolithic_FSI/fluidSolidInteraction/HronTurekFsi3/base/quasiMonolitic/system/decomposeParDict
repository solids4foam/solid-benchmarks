FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

numberOfSubdomains 12;

method scotch;

monolithicCoeffs
{
    regions (fluid solid);

    regionWeights
    {
        fluid 3; // nDofs in fluid cell
        solid 2; // nDofs in solid cell
    }

    interfaces
    (
        {
            regionA fluid;
            patchA  plate;
            regionB solid;
            patchB  plate;
        }
    );
}

