#!/bin/bash

# Source required functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions
source solids4FoamScripts.sh

set -u

# Usage:
#   ./Allrun [mesh|time|all|smoke]
#
# Environment overrides:
#   METHODS="monolithic:default monolithic:schurTuned partitioned:IQNILS"
#   MESH_LEVELS="1 2 3"
#   DT_VALUES="2e-3 1e-3 5e-4"
#   END_TIME=20
#   TOTAL_CORES=16   # total MPI ranks available across all concurrent cases
#   FORCE_SCALE=1.0    # 1/0.015 to convert from 15 mm extruded slab to 2D N/m
#   START_FRAC=0.5     # trailing-window fraction for last-period stats
#   MESH_CORES=(2 8 12) # processor counts for mesh levels 1, 2, 3

STUDY="${1:-${STUDY:-mesh}}"
END_TIME="${END_TIME:-20}"
TOTAL_CORES="${TOTAL_CORES:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)}"
FORCE_SCALE="${FORCE_SCALE:-1.0}"
START_FRAC="${START_FRAC:-0.5}"
MESH_CORES=(2 8 12)

if ! [[ "$TOTAL_CORES" =~ ^[0-9]+$ ]] || [[ "$TOTAL_CORES" -lt 1 ]]
then
    echo "TOTAL_CORES must be a positive integer, got '$TOTAL_CORES'" >&2
    exit 1
fi

DEFAULT_METHODS="monolithic:default monolithic:schurTuned monolithic:physicsPC partitioned:IQNILS partitioned:Aitken"
if [[ -n "${METHODS+x}" ]]
then
    USER_SET_METHODS=true
else
    USER_SET_METHODS=false
    METHODS="$DEFAULT_METHODS"
fi

case "$STUDY" in
    mesh)
        MESH_LEVELS="${MESH_LEVELS:-1 2 3}"
        DT_VALUES="${DT_VALUES:-1e-3}"
        ;;
    time)
        MESH_LEVELS="${MESH_LEVELS:-2}"
        DT_VALUES="${DT_VALUES:-2e-3 1e-3 5e-4 2.5e-4}"
        ;;
    all)
        MESH_LEVELS="${MESH_LEVELS:-1 2 3}"
        DT_VALUES="${DT_VALUES:-2e-3 1e-3 5e-4 2.5e-4}"
        ;;
    smoke)
        MESH_LEVELS="${MESH_LEVELS:-1}"
        DT_VALUES="${DT_VALUES:-1e-3}"
        END_TIME="${END_TIME_SMOKE:-${END_TIME:-0.1}}"
        if [[ "$END_TIME" == "20" ]]
        then
            END_TIME="0.1"
        fi
        if ! $USER_SET_METHODS
        then
            METHODS="monolithic:default partitioned:IQNILS"
        fi
        ;;
    *)
        echo "Unknown study '$STUDY'; expected mesh, time, all, or smoke"
        exit 1
        ;;
esac

methodBase()
{
    local method="$1"

    if [[ "$method" == "monolithic" ]]
    then
        echo "base/quasiMonolitic"
    else
        echo "base/partitioned"
    fi
}

caseName()
{
    local method="$1"
    local variant="$2"
    local mesh="$3"
    local dt="$4"

    echo "${method}_${variant}.m${mesh}.dt${dt//./p}"
}

meshCores()
{
    local mesh="$1"
    local index=$((mesh - 1))

    if (( index < 0 || index >= ${#MESH_CORES[@]} ))
    then
        echo "No processor count configured for mesh level ${mesh}" >&2
        return 1
    fi

    echo "${MESH_CORES[$index]}"
}

validatePositiveInteger()
{
    local name="$1"
    local value="$2"

    if ! [[ "$value" =~ ^[0-9]+$ ]] || [[ "$value" -lt 1 ]]
    then
        echo "${name} must be a positive integer, got '${value}'" >&2
        return 1
    fi
}

queueCase()
{
    local method="$1"
    local variant="$2"
    local mesh="$3"
    local dt="$4"
    local base="$5"
    local caseName="$6"
    local deltaX="$7"
    local cores="$8"

    QUEUE_METHODS+=("$method")
    QUEUE_VARIANTS+=("$variant")
    QUEUE_BASES+=("$base")
    QUEUE_CASES+=("$caseName")
    QUEUE_MESHES+=("$mesh")
    QUEUE_DELTAXS+=("$deltaX")
    QUEUE_DTS+=("$dt")
    QUEUE_CORES+=("$cores")
    QUEUE_DIRS+=("${RUN_ROOT}/${caseName}")
    QUEUE_LOGS+=("${RUN_ROOT}/log.${caseName}")
    QUEUE_STATUS_FILES+=("${RUN_ROOT}/${caseName}.status")
}

setNumberOfSubdomains()
{
    local dict="$1"
    local cores="$2"

    if [[ ! -f "$dict" ]]
    then
        echo "Cannot find $dict"
        return 1
    fi

    if ! grep -q "^[[:space:]]*numberOfSubdomains[[:space:]]" "$dict"
    then
        echo "Cannot find numberOfSubdomains in $dict"
        return 1
    fi

    sed -i \
        "/^[[:space:]]*numberOfSubdomains[[:space:]]/s|^.*|numberOfSubdomains ${cores};|" \
        "$dict"
}

activateMethod()
{
    local method="$1"
    local variant="$2"

    if [[ "$method" == "monolithic" ]]
    then
        for file in $(find ./0 ./constant ./system -name '*.monolithic')
        do
            if [[ "${file##*/}" == "decomposeParDict.monolithic" ]]
            then
                continue
            fi

            ln -vnsf "${file##*/}" "${file%.*}"
        done

        if [[ "$variant" != "default" ]]
        then
            local variantFile="system/fvSolution.monolithic.${variant}"

            if [[ -f "$variantFile" ]]
            then
                ln -vnsf "fvSolution.monolithic.${variant}" system/fvSolution
            else
                echo "Cannot find $variantFile"
                return 1
            fi
        fi
    else
        for file in $(find ./0 ./constant ./system -name '*.partitioned')
        do
            ln -vnsf "${file##*/}" "${file%.*}"
        done

        sed -i \
            "/^[[:space:]]*fluidSolidInterface[[:space:]]/s|^.*|fluidSolidInterface    ${variant};|" \
            constant/fsiProperties
    fi
}

runTimed()
{
    local logFile="$1"
    local tmpLog="${logFile}.tmp"
    shift
    rm -f "$tmpLog"

    if command -v gtime &> /dev/null
    then
        gtime -f "gtime/time (wall clock) time: %e\nMaximum resident set size (kbytes): %M" \
            "$@" &> "$tmpLog"
    elif [ -x /usr/bin/time ]
    then
        /usr/bin/time -f "gtime/time (wall clock) time: %e\nMaximum resident set size (kbytes): %M" \
            "$@" &> "$tmpLog"
    else
        "$@" &> "$tmpLog"
    fi

    local rc=$?
    mv -f "$tmpLog" "$logFile"
    return $rc
}

runSolver()
{
    runTimed log.solids4Foam solids4Foam
}

runParallelSolver()
{
    set +u
    solids4Foam::runParallel solids4Foam
    local rc=$?
    set -u
    return $rc
}

verifyConformalInterface()
{
    # Returns 0 if fluid plate face count == solid plate face count.
    local fluidFaces=""
    local solidFaces=""

    if [[ -f log.checkMesh.fluid ]]
    then
        fluidFaces=$(awk '/^[[:space:]]+plate[[:space:]]/ {print $2; exit}' \
                          log.checkMesh.fluid)
    fi

    if [[ -f log.checkMesh.solid ]]
    then
        solidFaces=$(awk '/^[[:space:]]+plate[[:space:]]/ {print $2; exit}' \
                          log.checkMesh.solid)
    fi

    echo "Plate faces: fluid=${fluidFaces:-?}, solid=${solidFaces:-?}"

    if [[ -n "$fluidFaces" && -n "$solidFaces" && "$fluidFaces" == "$solidFaces" ]]
    then
        return 0
    fi
    return 1
}

appendSummary()
{
    local summary="$1"
    local caseDir="$2"
    local study="$3"
    local method="$4"
    local variant="$5"
    local case="$6"
    local mesh="$7"
    local deltaX="$8"
    local dt="$9"
    local status="${10}"

    local clockTime="NaN"
    local maxMemory="NaN"
    local cellsFluid="NaN"
    local cellsSolid="NaN"
    local stats="NaN NaN NaN NaN NaN NaN NaN NaN NaN NaN NaN NaN"

    if grep -q "gtime/time" "${caseDir}/log.solids4Foam" 2>/dev/null
    then
        clockTime=$(grep "gtime/time" "${caseDir}/log.solids4Foam" | tail -1 | awk '{print $5}')
    elif [[ -f "${caseDir}/log.solids4Foam" ]]
    then
        clockTime=$(grep "ClockTime" "${caseDir}/log.solids4Foam" | tail -1 | awk '{print $7}')
    fi

    if grep -q "Maximum resident" "${caseDir}/log.solids4Foam" 2>/dev/null
    then
        maxMemory=$(grep "Maximum resident" "${caseDir}/log.solids4Foam" | tail -1 | awk '{print int($6 / 1000)}')
    fi

    if [[ -f "${caseDir}/log.checkMesh.fluid" ]]
    then
        cellsFluid=$(grep "cells:" "${caseDir}/log.checkMesh.fluid" | tail -1 | awk '{print $2}')
    fi

    if [[ -f "${caseDir}/log.checkMesh.solid" ]]
    then
        cellsSolid=$(grep "cells:" "${caseDir}/log.checkMesh.solid" | tail -1 | awk '{print $2}')
    fi

    if [[ -d "${caseDir}/postProcessing" ]]
    then
        local got
        got=$(python3 "../extractLastPeriod.py" "${caseDir}" \
                 --force-scale "$FORCE_SCALE" --start-frac "$START_FRAC" 2>/dev/null \
              || echo "")
        if [[ -n "$got" ]]
        then
            stats="$got"
        fi
    fi

    echo "${study} ${method} ${variant} ${case} ${mesh} ${deltaX} ${dt} ${status} ${cellsFluid} ${cellsSolid} ${clockTime} ${maxMemory} ${stats}" \
        >> "${summary}"
}

runCaseWorker()
{
    local caseDir="$1"
    local logFile="$2"
    local statusFile="$3"
    local method="$4"
    local variant="$5"
    local mesh="$6"
    local dt="$7"
    local base="$8"
    local caseName="$9"
    local totalCores="${10}"

    (
        local caseStatus="failed"
        local solverStatus=0
        trap 'printf "%s\n" "${caseStatus}" > "${statusFile}"' EXIT

        rm -rf "${caseDir}"
        mkdir -p "${caseDir}"
        cp -rL "../${base}/." "${caseDir}"

        cd "${caseDir}" || exit 1

        if activateMethod "$method" "$variant"
        then
            cp "system/solid/blockMeshDict.${mesh}" system/solid/blockMeshDict
            cp "system/fluid/blockMeshDict.${mesh}" system/fluid/blockMeshDict

            sed -i "/^[[:space:]]*deltaT[[:space:]]/s|^.*|deltaT          ${dt};|" system/controlDict
            sed -i "/^[[:space:]]*endTime[[:space:]]/s|^.*|endTime         ${END_TIME};|" system/controlDict

            solids4Foam::runApplication -s solid blockMesh -region solid
            solids4Foam::runApplication -s fluid blockMesh -region fluid
            solids4Foam::runApplication -s fluid checkMesh -region fluid
            solids4Foam::runApplication -s solid checkMesh -region solid

            if ! verifyConformalInterface
            then
                echo "Conformal-interface check failed; aborting case."
                caseStatus="failed"
            else
                local cores
                cores=$(meshCores "$mesh") || solverStatus=$?

                if [[ "$solverStatus" -eq 0 ]]
                then
                    if [[ "$cores" -gt "$totalCores" ]]
                    then
                        echo "Case ${caseName} requires ${cores} cores, but TOTAL_CORES=${totalCores}"
                        solverStatus=1
                    elif [[ "$cores" -gt 1 ]]
                    then
                        if [[ "$method" == "monolithic" ]]
                        then
                            setNumberOfSubdomains system/decomposeParDict "$cores" || solverStatus=$?
                            if [[ "$solverStatus" -eq 0 ]]
                            then
                                decomposeParMonolithic &> log.decomposeParMonolithic || solverStatus=$?
                            fi
                            if [[ "$solverStatus" -eq 0 ]]
                            then
                                runParallelSolver || solverStatus=$?
                            fi
                        else
                            setNumberOfSubdomains system/decomposeParDict "$cores" || solverStatus=$?
                            if [[ "$solverStatus" -eq 0 ]]
                            then
                                setNumberOfSubdomains system/solid/decomposeParDict "$cores" || solverStatus=$?
                            fi
                            if [[ "$solverStatus" -eq 0 ]]
                            then
                                setNumberOfSubdomains system/fluid/decomposeParDict "$cores" || solverStatus=$?
                            fi
                            if [[ "$solverStatus" -eq 0 ]]
                            then
                                solids4Foam::runApplication -s fluid decomposePar -region fluid || solverStatus=$?
                            fi
                            if [[ "$solverStatus" -eq 0 ]]
                            then
                                solids4Foam::runApplication -s solid decomposePar -region solid || solverStatus=$?
                            fi
                            if [[ "$solverStatus" -eq 0 ]]
                            then
                                runParallelSolver || solverStatus=$?
                            fi
                            if [[ "$solverStatus" -eq 0 ]]
                            then
                                solids4Foam::runApplication -s fluid reconstructPar -region fluid || solverStatus=$?
                            fi
                            if [[ "$solverStatus" -eq 0 ]]
                            then
                                solids4Foam::runApplication -s solid reconstructPar -region solid || solverStatus=$?
                            fi
                        fi
                    else
                        runSolver || solverStatus=$?
                    fi

                    if [[ "$solverStatus" -eq 0 ]]
                    then
                        caseStatus="ranToEnd"
                    fi
                fi
            fi
        fi
    ) > "${logFile}" 2>&1
}

reapFinishedJobs()
{
    local alivePids=()
    local aliveCores=()
    local pid core rc

    for ((idx=0; idx<${#ACTIVE_PIDS[@]}; ++idx))
    do
        pid="${ACTIVE_PIDS[$idx]}"
        core="${ACTIVE_CORES[$idx]}"

        if kill -0 "${pid}" 2>/dev/null
        then
            alivePids+=("${pid}")
            aliveCores+=("${core}")
        else
            wait "${pid}"
            rc=$?
            ACTIVE_CORE_USAGE=$((ACTIVE_CORE_USAGE - core))
            if [[ "${rc}" -ne 0 ]]
            then
                ACTIVE_FAILURES=$((ACTIVE_FAILURES + 1))
            fi
        fi
    done

    if (( ${#alivePids[@]} > 0 ))
    then
        ACTIVE_PIDS=("${alivePids[@]}")
    else
        ACTIVE_PIDS=()
    fi

    if (( ${#aliveCores[@]} > 0 ))
    then
        ACTIVE_CORES=("${aliveCores[@]}")
    else
        ACTIVE_CORES=()
    fi
}

waitForCoreBudget()
{
    local required="$1"

    while true
    do
        reapFinishedJobs

        if (( ACTIVE_CORE_USAGE + required <= TOTAL_CORES ))
        then
            return 0
        fi

        if (( ACTIVE_CORE_USAGE + required > TOTAL_CORES ))
        then
            sleep 1
        fi
    done
}

ACTIVE_PIDS=()
ACTIVE_CORES=()
ACTIVE_CORE_USAGE=0
ACTIVE_FAILURES=0

# Detect the CPU type: append this to the run directory name
if [[ "$OSTYPE" == "darwin"* ]]
then
    CPU_TYPE=$(sysctl -n machdep.cpu.brand_string 2>/dev/null | sed 's/[^a-zA-Z0-9]/_/g')
elif [[ -f /proc/cpuinfo ]]
then
    CPU_TYPE=$(grep -m 1 "model name" /proc/cpuinfo | awk -F': ' '{print $2}' | sed 's/[^a-zA-Z0-9]/_/g')
else
    CPU_TYPE="Unknown_CPU"
fi

if [[ -z "$CPU_TYPE" ]]
then
    CPU_TYPE="$(uname -m)"
fi

DATE=$(date +%Y-%m-%d_%H-%M-%S)
RUN_DIR="run_${STUDY}_${CPU_TYPE}_${DATE}"
SUMMARY="campaignSummary.tsv"
QUEUE_METHODS=()
QUEUE_VARIANTS=()
QUEUE_BASES=()
QUEUE_CASES=()
QUEUE_MESHES=()
QUEUE_DELTAXS=()
QUEUE_DTS=()
QUEUE_CORES=()
QUEUE_DIRS=()
QUEUE_LOGS=()
QUEUE_STATUS_FILES=()

echo "Creating ${RUN_DIR}"
mkdir "${RUN_DIR}"
cd "${RUN_DIR}"
RUN_ROOT="$(pwd)"

echo "# Study Method Variant Case Mesh DeltaX DeltaT Status CellsFluid CellsSolid WallTime MaxMemoryMb UxMean UxAmp UxFreq UyMean UyAmp UyFreq FxMean FxAmp FxFreq FyMean FyAmp FyFreq" \
    > "$SUMMARY"

for methodVariant in $METHODS
do
    METHOD="${methodVariant%%:*}"
    VARIANT="${methodVariant#*:}"
    BASE="$(methodBase "$METHOD")"

    for mesh in $MESH_LEVELS
    do
        CORES=$(meshCores "$mesh") || exit 1

        validatePositiveInteger "core demand for mesh ${mesh}" "$CORES" || exit 1
        if (( CORES > TOTAL_CORES ))
        then
            echo "Case mesh ${mesh} requires ${CORES} cores, but TOTAL_CORES=${TOTAL_CORES}" >&2
            exit 1
        fi

        # Plate-thickness cell size in mm. Level 1 has 5 cells over 20 mm => 4 mm.
        # Each refinement halves the cell size.
        DELTAX=$(awk -v i="$mesh" 'BEGIN {printf "%.12g", 4.0/(2^(i - 1))}')

        for dt in $DT_VALUES
        do
            CASE="$(caseName "$METHOD" "$VARIANT" "$mesh" "$dt")"
            queueCase "$METHOD" "$VARIANT" "$mesh" "$dt" "$BASE" "$CASE" "$DELTAX" "$CORES"
        done
    done
done

for idx in "${!QUEUE_CASES[@]}"
do
    CASE="${QUEUE_CASES[$idx]}"
    METHOD="${QUEUE_METHODS[$idx]}"
    VARIANT="${QUEUE_VARIANTS[$idx]}"
    MESH="${QUEUE_MESHES[$idx]}"
    DT="${QUEUE_DTS[$idx]}"
    BASE="${QUEUE_BASES[$idx]}"
    LOG_FILE="${QUEUE_LOGS[$idx]}"
    STATUS_FILE="${QUEUE_STATUS_FILES[$idx]}"
    CORES="${QUEUE_CORES[$idx]}"
    CASE_DIR="${QUEUE_DIRS[$idx]}"

    waitForCoreBudget "${CORES}"

    echo
    echo "***************************************"
    echo "Launching case: ${CASE}"
    echo "Method: ${METHOD}, variant: ${VARIANT}, mesh: ${MESH}, deltaT: ${DT}, endTime: ${END_TIME}"
    echo "***************************************"

    runCaseWorker "${CASE_DIR}" "${LOG_FILE}" "${STATUS_FILE}" "${METHOD}" "${VARIANT}" "${MESH}" "${DT}" "${BASE}" "${CASE}" "${TOTAL_CORES}" &
    ACTIVE_PIDS+=("$!")
    ACTIVE_CORES+=("${CORES}")
    ACTIVE_CORE_USAGE=$((ACTIVE_CORE_USAGE + CORES))
done

while (( ${#ACTIVE_PIDS[@]} > 0 ))
do
    reapFinishedJobs

    if (( ${#ACTIVE_PIDS[@]} > 0 ))
    then
        sleep 1
    fi
done

FAILED_CASES=0
for idx in "${!QUEUE_CASES[@]}"
do
    CASE="${QUEUE_CASES[$idx]}"
    METHOD="${QUEUE_METHODS[$idx]}"
    VARIANT="${QUEUE_VARIANTS[$idx]}"
    MESH="${QUEUE_MESHES[$idx]}"
    DELTAX="${QUEUE_DELTAXS[$idx]}"
    DT="${QUEUE_DTS[$idx]}"
    STATUS_FILE="${QUEUE_STATUS_FILES[$idx]}"
    CASE_DIR="${QUEUE_DIRS[$idx]}"
    STATUS="failed"

    if [[ -f "${STATUS_FILE}" ]]
    then
        read -r STATUS < "${STATUS_FILE}"
    fi

    if [[ -z "${STATUS}" ]]
    then
        STATUS="failed"
    fi

    appendSummary "$SUMMARY" "$CASE_DIR" "$STUDY" "$METHOD" "$VARIANT" "$CASE" "$MESH" "$DELTAX" "$DT" "$STATUS"

    if [[ "$STATUS" != "ranToEnd" ]]
    then
        FAILED_CASES=$((FAILED_CASES + 1))
    fi
done

if command -v gnuplot &>/dev/null
then
    cp ../plotScripts/campaign*.gnuplot . 2>/dev/null || true

    for f in campaign*.gnuplot
    do
        [[ -f "$f" ]] || continue
        echo "Running gnuplot on $f"
        gnuplot -c "$f" "$SUMMARY"
    done
fi

if (( FAILED_CASES > 0 ))
then
    echo
    echo "Completed with ${FAILED_CASES} failed case(s)"
fi

cd ..

echo
echo "Done"
echo "Run directory: ${RUN_DIR}"
echo "Summary: ${RUN_DIR}/${SUMMARY}"
echo
echo "$(date)"
