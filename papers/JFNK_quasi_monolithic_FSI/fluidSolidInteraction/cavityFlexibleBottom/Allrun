#!/bin/bash

# Source required functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions
source solids4FoamScripts.sh

set -u

# Usage:
#   ./Allrun [mesh|time|all|smoke]
#
# Environment overrides:
#   METHODS="monolithic:default monolithic:schurTuned partitioned:IQNILS"
#   MESH_LEVELS="1 2 3 4"
#   DT_VALUES="0.5 1 2.5 5 10"
#   END_TIME=10000
#   STEADY_MIN_TIME=20
#   STEADY_N_SAMPLES=10
#   STEADY_N_CONSECUTIVE=3

STUDY="${1:-${STUDY:-mesh}}"
END_TIME="${END_TIME:-10000}"
STEADY_MIN_TIME="${STEADY_MIN_TIME:-20}"
STEADY_N_SAMPLES="${STEADY_N_SAMPLES:-10}"
STEADY_N_CONSECUTIVE="${STEADY_N_CONSECUTIVE:-3}"
STEADY_DISP_REL_TOL="${STEADY_DISP_REL_TOL:-1e-5}"
STEADY_FORCE_REL_TOL="${STEADY_FORCE_REL_TOL:-1e-5}"

DEFAULT_METHODS="monolithic:default monolithic:schurTuned monolithic:physicsPC partitioned:IQNILS partitioned:Aitken"
if [[ -v METHODS ]]
then
    USER_SET_METHODS=true
else
    USER_SET_METHODS=false
    METHODS="$DEFAULT_METHODS"
fi

case "$STUDY" in
    mesh)
        MESH_LEVELS="${MESH_LEVELS:-1 2 3 4}"
        DT_VALUES="${DT_VALUES:-0.5}"
        ;;
    time)
        MESH_LEVELS="${MESH_LEVELS:-3}"
        DT_VALUES="${DT_VALUES:-0.5 1 2.5 5 10 20 40}"
        ;;
    all)
        MESH_LEVELS="${MESH_LEVELS:-1 2 3 4}"
        DT_VALUES="${DT_VALUES:-0.5 1 2.5 5 10 20 40}"
        ;;
    smoke)
        MESH_LEVELS="${MESH_LEVELS:-1}"
        DT_VALUES="${DT_VALUES:-0.5}"
        if ! $USER_SET_METHODS
        then
            METHODS="monolithic:default partitioned:IQNILS"
        fi
        ;;
    *)
        echo "Unknown study '$STUDY'; expected mesh, time, all, or smoke"
        exit 1
        ;;
esac

setControlEntry()
{
    local key="$1"
    local value="$2"
    local file="$3"

    sed -i "/^[[:space:]]*${key}[[:space:]]/s|^.*|        ${key} ${value};|" "$file"
}

methodBase()
{
    local method="$1"

    if [[ "$method" == "monolithic" ]]
    then
        echo "base/quasiMonolitic"
    else
        echo "base/partitioned"
    fi
}

caseName()
{
    local method="$1"
    local variant="$2"
    local mesh="$3"
    local dt="$4"

    echo "${method}_${variant}.m${mesh}.dt${dt//./p}"
}

activateMethod()
{
    local method="$1"
    local variant="$2"

    if [[ "$method" == "monolithic" ]]
    then
        for file in $(find ./0 ./constant ./system -name '*.monolithic')
        do
            ln -vnsf "${file##*/}" "${file%.*}"
        done

        if [[ "$variant" != "default" ]]
        then
            local variantFile="system/fvSolution.monolithic.${variant}"

            if [[ -f "$variantFile" ]]
            then
                ln -vnsf "fvSolution.monolithic.${variant}" system/fvSolution
            else
                echo "Cannot find $variantFile"
                return 1
            fi
        fi
    else
        for file in $(find ./0 ./constant ./system -name '*.partitioned')
        do
            ln -vnsf "${file##*/}" "${file%.*}"
        done

        sed -i \
            "/^[[:space:]]*fluidSolidInterface[[:space:]]/s|^.*|fluidSolidInterface    ${variant};|" \
            constant/fsiProperties
    fi
}

runSolver()
{
    if command -v gtime &> /dev/null
    then
        gtime -f "gtime/time (wall clock) time: %e\nMaximum resident set size (kbytes): %M" \
            solids4Foam &> log.solids4Foam
    elif [ -x /usr/bin/time ]
    then
        /usr/bin/time -f "gtime/time (wall clock) time: %e\nMaximum resident set size (kbytes): %M" \
            solids4Foam &> log.solids4Foam
    else
        solids4Foam &> log.solids4Foam
    fi
}

appendSummary()
{
    local summary="$1"
    local study="$2"
    local method="$3"
    local variant="$4"
    local case="$5"
    local mesh="$6"
    local deltaX="$7"
    local dt="$8"
    local status="$9"

    local clockTime="NaN"
    local maxMemory="NaN"
    local cellsFluid="NaN"
    local cellsSolid="NaN"
    local steadyTime="NaN"
    local uy="NaN"
    local fy="NaN"
    local dispRel="NaN"
    local forceRel="NaN"
    local consecutive="NaN"

    if grep -q "gtime/time" log.solids4Foam
    then
        clockTime=$(grep "gtime/time" log.solids4Foam | tail -1 | awk '{print $5}')
    else
        clockTime=$(grep "ClockTime" log.solids4Foam | tail -1 | awk '{print $7}')
    fi

    if grep -q "Maximum resident" log.solids4Foam
    then
        maxMemory=$(grep "Maximum resident" log.solids4Foam | tail -1 | awk '{print int($6 / 1000)}')
    fi

    if [[ -f log.checkMesh.fluid ]]
    then
        cellsFluid=$(grep "cells:" log.checkMesh.fluid | tail -1 | awk '{print $2}')
    fi

    if [[ -f log.checkMesh.solid ]]
    then
        cellsSolid=$(grep "cells:" log.checkMesh.solid | tail -1 | awk '{print $2}')
    fi

    local steadyFile="postProcessing/0/fsiSteadyStateControl.dat"

    if [[ -f "$steadyFile" ]]
    then
        read -r steadyTime uy fy _ dispRel _ forceRel consecutive _ <<< \
            "$(awk 'NF && $1 !~ /^#/ {line=$0} END {print line}' "$steadyFile")"
    else
        if [[ -f postProcessing/0/solidPointDisplacement_pointDisp.dat ]]
        then
            uy=$(awk 'NF && $1 !~ /^#/ {v=$3} END {print v}' \
                postProcessing/0/solidPointDisplacement_pointDisp.dat)
        fi

        if [[ -f postProcessing/fluid/forces/0/force.dat ]]
        then
            fy=$(awk 'NF && $1 !~ /^#/ {v=$3} END {print v}' \
                postProcessing/fluid/forces/0/force.dat)
        fi
    fi

    echo "${study} ${method} ${variant} ${case} ${mesh} ${deltaX} ${dt} ${status} ${cellsFluid} ${cellsSolid} ${clockTime} ${maxMemory} ${steadyTime} ${uy} ${fy} ${dispRel} ${forceRel} ${consecutive}" \
        >> "../${summary}"
}

# Detect the CPU type: append this to the run directory name
if [[ "$OSTYPE" == "darwin"* ]]
then
    CPU_TYPE=$(sysctl -n machdep.cpu.brand_string | sed 's/[^a-zA-Z0-9]/_/g')
elif [[ -f /proc/cpuinfo ]]
then
    CPU_TYPE=$(grep -m 1 "model name" /proc/cpuinfo | awk -F': ' '{print $2}' | sed 's/[^a-zA-Z0-9]/_/g')
else
    CPU_TYPE="Unknown_CPU"
fi

DATE=$(date +%Y-%m-%d_%H-%M-%S)
RUN_DIR="run_${STUDY}_${CPU_TYPE}_${DATE}"
SUMMARY="campaignSummary.tsv"

echo "Creating ${RUN_DIR}"
mkdir "${RUN_DIR}"
cd "${RUN_DIR}"

echo "# Study Method Variant Case Mesh DeltaX DeltaT Status CellsFluid CellsSolid WallTime MaxMemoryMb SteadyTime Uy Fy DisplacementRelChange ForceRelChange Consecutive" \
    > "$SUMMARY"

for methodVariant in $METHODS
do
    METHOD="${methodVariant%%:*}"
    VARIANT="${methodVariant#*:}"
    BASE="$(methodBase "$METHOD")"

    for mesh in $MESH_LEVELS
    do
        # The supplied meshes are uniform h-refinements with level 1 matching
        # Tukovic DeltaX ~= 0.1.
        DELTAX=$(awk -v i="$mesh" 'BEGIN {printf "%.12g", 0.1/(2^(i - 1))}')

        for dt in $DT_VALUES
        do
            CASE="$(caseName "$METHOD" "$VARIANT" "$mesh" "$dt")"

            echo
            echo "***************************************"
            echo "Processing case: $CASE"
            echo "Method: $METHOD, variant: $VARIANT, mesh: $mesh, deltaT: $dt"
            echo "***************************************"

            cp -rL "../${BASE}" "$CASE"
            cd "$CASE"

            STATUS="failed"

            if activateMethod "$METHOD" "$VARIANT"
            then
                cp "system/solid/blockMeshDict.${mesh}" system/solid/blockMeshDict
                cp "system/fluid/blockMeshDict.${mesh}" system/fluid/blockMeshDict

                sed -i "/^[[:space:]]*deltaT[[:space:]]/s|^.*|deltaT          ${dt};|" system/controlDict
                sed -i "/^[[:space:]]*endTime[[:space:]]/s|^.*|endTime         ${END_TIME};|" system/controlDict
                setControlEntry minTime "$STEADY_MIN_TIME" system/controlDict
                setControlEntry nSamples "$STEADY_N_SAMPLES" system/controlDict
                setControlEntry nConsecutive "$STEADY_N_CONSECUTIVE" system/controlDict
                setControlEntry displacementRelTol "$STEADY_DISP_REL_TOL" system/controlDict
                setControlEntry forceRelTol "$STEADY_FORCE_REL_TOL" system/controlDict

                solids4Foam::runApplication -s solid blockMesh -region solid
                solids4Foam::runApplication -s fluid blockMesh -region fluid
                solids4Foam::runApplication -s fluid checkMesh -region fluid
                solids4Foam::runApplication -s solid checkMesh -region solid

                if [[ $WM_PROJECT = "OpenFOAM" ]] && [[ $WM_PROJECT != *"v"* ]]
                then
                    cd 0/fluid/ && ln -sf inlet.fixedProfile velocityInletProfile && cd ../..
                else
                    cd 0/fluid/ && ln -sf inlet.parabolic velocityInletProfile && cd ../..
                fi

                runSolver
                SOLVER_STATUS=$?

                if [[ $SOLVER_STATUS -ne 0 ]]
                then
                    STATUS="failed"
                elif grep -q "steady state detected" log.solids4Foam
                then
                    STATUS="steady"
                else
                    STATUS="hitEndTime"
                fi
            fi

            appendSummary "$SUMMARY" "$STUDY" "$METHOD" "$VARIANT" "$CASE" "$mesh" "$DELTAX" "$dt" "$STATUS"

            echo
            tail -n 5 "../${SUMMARY}"
            cd ..
        done
    done
done

if command -v gnuplot &>/dev/null
then
    cp ../plotScripts/*.gnuplot .

    for f in campaign*.gnuplot
    do
        echo "Running gnuplot on $f"
        gnuplot -c "$f" "$SUMMARY"
    done

    gnuplot campaignSummary.gnuplot
fi

cd ..

echo
echo "Done"
echo "Run directory: ${RUN_DIR}"
echo "Summary: ${RUN_DIR}/${SUMMARY}"
echo
echo "$(date)"
