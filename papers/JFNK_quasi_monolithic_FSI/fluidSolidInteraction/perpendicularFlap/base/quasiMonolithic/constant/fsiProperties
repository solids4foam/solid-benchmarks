FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fsiProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

fluidSolidInterface NewtonQuasiMonolithic;

NewtonQuasiMonolithicCoeffs
{
    solidPatch interface;
    fluidPatch flap;

    coupled         yes;

    interfaceTransferMethod directMap;

    passViscousStress yes;

    fluidSystemScaleFactor 1e+08;
}

