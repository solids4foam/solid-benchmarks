#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
MODE=${RUN_MODE:-full}
TARGET=all
LIST_ONLY=false

usage()
{
    cat <<'EOF'
Usage: ./Allrun [structured|parameter|unstructured|plots] [--list]

With no target, run all three studies and generate the six paper figures.
Set RUN_MODE=test, or use ./AllrunTest, to select only the first two meshes.
Use --list to validate and print the cases without creating or running them.
EOF
}

for argument in "$@"
do
    case "$argument" in
        structured|parameter|unstructured|plots)
            if [[ "$TARGET" != all ]]
            then
                echo "ERROR: specify at most one workflow target" >&2
                exit 2
            fi
            TARGET=$argument
            ;;
        --list)
            LIST_ONLY=true
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "ERROR: unknown argument: $argument" >&2
            usage >&2
            exit 2
            ;;
    esac
done

case "$MODE" in
    full|test) ;;
    *)
        echo "ERROR: RUN_MODE must be 'full' or 'test', not '$MODE'" >&2
        exit 2
        ;;
esac

# Refresh the OpenFOAM environment in this process.  This is important on
# macOS, where PATH can remain populated while DYLD_LIBRARY_PATH has been
# stripped by an application launcher, leaving solids4Foam present but unable
# to load libOpenFOAM.dylib.  OpenFOAM's setup helpers contain optional probes
# that may return non-zero, so errexit is disabled only while sourcing them.
if [[ "$LIST_ONLY" == false && "$TARGET" != plots ]]
then
    OPENFOAM_ENV=${OPENFOAM_BASHRC:-}
    if [[ -z "$OPENFOAM_ENV" && -n "${WM_PROJECT_DIR:-}" ]]
    then
        OPENFOAM_ENV="$WM_PROJECT_DIR/etc/bashrc"
    fi
    if [[ -z "$OPENFOAM_ENV" ]] && command -v blockMesh >/dev/null 2>&1
    then
        BLOCKMESH_PATH=$(command -v blockMesh)
        if [[ "$BLOCKMESH_PATH" == */platforms/* ]]
        then
            OPENFOAM_ENV="${BLOCKMESH_PATH%%/platforms/*}/etc/bashrc"
        fi
    fi
    if [[ -n "$OPENFOAM_ENV" ]]
    then
        if [[ ! -f "$OPENFOAM_ENV" ]]
        then
            echo "ERROR: OpenFOAM environment file does not exist: $OPENFOAM_ENV" >&2
            exit 1
        fi
        set +e
        set +u
        # shellcheck disable=SC1090
        source "$OPENFOAM_ENV"
        SOURCE_STATUS=$?
        set -e
        set -u
        if [[ $SOURCE_STATUS -ne 0 ]]
        then
            echo "ERROR: failed to source OpenFOAM environment: $OPENFOAM_ENV" >&2
            exit 1
        fi
    fi
fi

command -v python3 >/dev/null 2>&1 || {
    echo "ERROR: python3 is required" >&2
    exit 1
}

arguments=(--mode "$MODE" --target "$TARGET")
if [[ "$LIST_ONLY" == true ]]
then
    arguments+=(--list)
fi

exec python3 "$SCRIPT_DIR/scripts/workflow.py" "${arguments[@]}"
