#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

echo "Removing generated Cook's membrane runs, results and figures"
rm -rf \
    "$SCRIPT_DIR/runs" \
    "$SCRIPT_DIR/results" \
    "$SCRIPT_DIR/figures"

find "$SCRIPT_DIR" -maxdepth 1 -type d -name 'run_*' -exec rm -rf {} +
find "$SCRIPT_DIR/scripts" "$SCRIPT_DIR/plotScripts" \
    -type d -name '__pycache__' -prune -exec rm -rf {} + 2>/dev/null || true

echo "Canonical bases, mesh definitions, plotting sources and reference data retained"
