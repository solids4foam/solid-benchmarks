FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solidProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solidModel     linearGeometryTotalDisplacement;

"linearGeometryTotalDisplacementCoeffs|unsLinearGeometryCoeffs"
{
    // Solution algorithm
    solutionAlgorithm PETScSNES;

    // PETSc options file used by PETScSNES
    optionsFile petscOptions.split;
    solvePressure true;

    stabilisation
    {
        momentum
        {
            type        diffStencilLaplacian;
            scaleFactor 1.0;
        }

        pressure
        {
            type            generalisedEvenOrderLaplacian;
            scaleFactor     10.0;
            scaleFactorJacobian 10.0;
            laplacianPower  2;
        }
    }
}

// ************************************************************************* //
