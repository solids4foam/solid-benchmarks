#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
MODE=${1:-${RUN_MODE:-full}}

case "$MODE" in
    full|test) ;;
    *)
        echo "Usage: ./plotScripts/Allrun [full|test]" >&2
        exit 2
        ;;
esac

RUN_MODE=$MODE exec "$ROOT/Allrun" plots
