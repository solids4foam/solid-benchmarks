set term pdfcairo dashed enhanced
set datafile commentschars "#"

set size ratio -1
set grid
set xrange [-10:0]
set yrange [-20:5]
set xtics 5
set ytics
set xlabel "x (in mm)"
set ylabel "z (in mm)"
set key off

# Every mesh level generated by ./Allrun, in mesh-level order. Run this script
# from the case directory (the one holding runs/).
midlines = system("ls runs/mesh*/midLineDeformed.txt 2>/dev/null | sort -V")
if (words(midlines) == 0) {
    print "No runs/mesh*/midLineDeformed.txt found: run ./Allrun first."
    exit
}

# The reference curve is only drawn when the reference data is present.
refFile = "referenceData/land3PlotData.csv"
haveRef = 0 + system(sprintf("test -f %s && echo 1 || echo 0", refFile))
reference = sprintf("< sed '1d; s/,/ /g' %s 2>/dev/null", refFile)
set style line 1 lc rgb "black" dt 2 lw 1.2

set output "ventricleInflation-midline-deformed.pdf"
plot for [i=1:words(midlines)] word(midlines, i) u (1e3*$1):(1e3*$3) w l lw 1.2, \
     for [i=1:haveRef] reference u 1:2 w l ls 1, \
     for [i=1:words(midlines)] word(midlines, i) every 9::0 u (1e3*$1):(1e3*$3) w p pt 7 ps 0.7

set xrange [-2:0]
set yrange [-15:-13]
set size ratio 1
set output "ventricleInflation-midline-apex-deformed.pdf"
plot for [i=1:words(midlines)] word(midlines, i) u (1e3*$1):(1e3*$3) w lp pt 7 ps 0.7 lw 1.2

set xrange [-8.75:-8.25]
set yrange [-2:2]
set xtics 0.5
set size ratio 1
set output "ventricleInflation-midline-inflection-deformed.pdf"
plot for [i=1:words(midlines)] word(midlines, i) u (1e3*$1):(1e3*$3) w lp pt 7 ps 0.7 lw 1.2
