#!/bin/bash

set -eo pipefail

# Source required functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions
source solids4FoamScripts.sh

BASE="base/snes"
NAME="hex_snes"

# Pressure stabilisation methods using the new stabilisation framework
stabilisations=(
    "STAB=rhiechow STAB_FILE=solidProperties.rhiechow"
    "STAB=laplacian STAB_FILE=solidProperties.laplacian"
    "STAB=jst STAB_FILE=solidProperties.jst"
    "STAB=evenlap_m0 STAB_FILE=solidProperties.evenlap_m0"
    "STAB=evenlap_m1 STAB_FILE=solidProperties.evenlap_m1"
    "STAB=evenlap_m2 STAB_FILE=solidProperties.evenlap_m2"
)

# Optional method subset, for example:
#     STABS="rhiechow laplacian" START_MESH=1 END_MESH=1 ./Allrun
#
# The default uses the methods that are currently practical for this transient
# inflation benchmark with the supplied PETSc options.  Set STABS=all to also
# run the laplacian-family variants that still need further tuning here.
STABS="${STABS:-rhiechow jst evenlap_m1}"

# Mesh input files are defined from 1 to 6.  The default matches the original
# inflation benchmark; override START_MESH/END_MESH for shorter checks.
START_MESH="${START_MESH:-1}"
END_MESH="${END_MESH:-4}"

if ! command -v extractIdealisedVentricleResults &>/dev/null
then
    if [[ -d "extractIdealisedVentricleResults" ]]
    then
        echo "Compiling extractIdealisedVentricleResults"
        (
            cd extractIdealisedVentricleResults
            wmake
        )
    fi
fi

if ! command -v extractIdealisedVentricleResults &>/dev/null
then
    echo "ERROR: extractIdealisedVentricleResults is not available."
    echo "Compile it with: (cd extractIdealisedVentricleResults && wmake)"
    exit 1
fi

if [[ "$OSTYPE" == "darwin"* ]]
then
    CPU_BRAND=$(sysctl -n machdep.cpu.brand_string 2>/dev/null || true)
    if [[ -n "${CPU_BRAND}" ]]
    then
        CPU_TYPE=$(echo "${CPU_BRAND}" | sed 's/[^a-zA-Z0-9]/_/g')
    else
        CPU_TYPE=$(uname -m | sed 's/[^a-zA-Z0-9]/_/g')
    fi
elif [[ -f /proc/cpuinfo ]]
then
    CPU_TYPE=$(grep -m 1 "model name" /proc/cpuinfo | awk -F': ' '{print $2}' | sed 's/[^a-zA-Z0-9]/_/g')
else
    CPU_TYPE="Unknown_CPU"
fi

DATE=$(date +%Y%m%d_%H%M%S)
RUN_DIR="run_${CPU_TYPE}_${DATE}"
echo "Creating ${RUN_DIR}"
mkdir "${RUN_DIR}"

cd "${RUN_DIR}"

for stabConfig in "${stabilisations[@]}"
do
    eval "${stabConfig}"

    if [[ "${STABS}" != "all" && ! " ${STABS} " =~ " ${STAB} " ]]
    then
        continue
    fi

    echo; echo "***************************************"
    echo "Running pressure stabilisation: ${STAB}"
    echo "***************************************"

    SUMMARY="${NAME}__${STAB}.summary.txt"
    ITERATIONS="${NAME}__${STAB}.iterations.txt"
    echo "# Mesh Time Mem MidlinePoints" > "${SUMMARY}"
    echo "# Mesh SNESIts MaxLinearIts TotalLinearIts" > "${ITERATIONS}"

    for i in $(seq "${START_MESH}" "${END_MESH}")
    do
        CASE="${NAME}__${STAB}.${i}"
        echo; echo "Processing case: ${CASE}"

        cp -r "../${BASE}" "${CASE}"
        cd "${CASE}"

        if [[ ! -f "constant/${STAB_FILE}" ]]
        then
            echo "ERROR: missing constant/${STAB_FILE} in $(pwd)"
            exit 1
        fi
        cp "constant/${STAB_FILE}" constant/solidProperties

        if [[ ! -f "system/blockMeshDict.${i}" ]]
        then
            echo "Cannot find ${CASE}/system/blockMeshDict.${i}: please add it to ${BASE}/system/"
            exit 1
        fi
        cp "system/blockMeshDict.${i}" system/blockMeshDict

        if [[ ! -f "system/extrudeMeshDict.${i}" ]]
        then
            echo "Cannot find ${CASE}/system/extrudeMeshDict.${i}: please add it to ${BASE}/system/"
            exit 1
        fi
        cp "system/extrudeMeshDict.${i}" system/extrudeMeshDict

        solids4Foam::runApplication blockMesh
        solids4Foam::runApplication extrudeMesh
        solids4Foam::runApplication createPatch -overwrite

        set +e
        if command -v gtime &>/dev/null
        then
            echo "Running solids4Foam on ${CASE} with gtime"
            gtime -f "Maximum resident set size (kbytes): %M" mpirun -np 1 solids4Foam &> log.solids4Foam
            SOLVER_STATUS=$?
        elif command -v /usr/bin/time &>/dev/null && /usr/bin/time -f "Maximum resident set size (kbytes): %M" true &>/dev/null
        then
            echo "Running solids4Foam on ${CASE} with /usr/bin/time"
            /usr/bin/time -f "Maximum resident set size (kbytes): %M" mpirun -np 1 solids4Foam &> log.solids4Foam
            SOLVER_STATUS=$?
        else
            echo "Running solids4Foam on ${CASE}"
            mpirun -np 1 solids4Foam &> log.solids4Foam
            SOLVER_STATUS=$?
        fi
        set -e

        if [[ "${SOLVER_STATUS}" -ne 0 ]]
        then
            echo "solids4Foam failed for ${CASE}; see ${PWD}/log.solids4Foam"
            exit "${SOLVER_STATUS}"
        fi

        solids4Foam::runApplication extractIdealisedVentricleResults

        if [[ ! -f "midLineDeformed.txt" ]]
        then
            echo "extractIdealisedVentricleResults did not write midLineDeformed.txt"
            exit 1
        fi

        if grep -q "Maximum resident" log.solids4Foam
        then
            MAX_MEMORY=$(grep "Maximum resident" log.solids4Foam | tail -n 1 | awk '{print int($6 / 1000)}')
        else
            MAX_MEMORY="NaN"
        fi

        CLOCK_TIME=$(grep "ClockTime" log.solids4Foam | tail -n 1 | awk '{print $7}')
        MIDLINE_POINTS=$(wc -l < midLineDeformed.txt | tr -d ' ')
        SNES_ITS=$(grep "Nonlinear solve converged" log.solids4Foam | tail -n 1 | awk '{print $NF}')
        if [[ -z "${SNES_ITS}" ]]
        then
            SNES_ITS="NaN"
        fi
        read MAX_LINEAR_ITS TOTAL_LINEAR_ITS <<< \
            $(awk '/Linear solve/ && /iterations/ {sum += $NF; if ($NF > max) max = $NF} END {print max+0, sum+0}' log.solids4Foam)

        echo "${i} ${CLOCK_TIME} ${MAX_MEMORY} ${MIDLINE_POINTS}" >> ../"${SUMMARY}"
        echo "${i} ${SNES_ITS} ${MAX_LINEAR_ITS} ${TOTAL_LINEAR_ITS}" >> ../"${ITERATIONS}"

        cd ..
    done

    echo; echo "${SUMMARY} file:"; cat "${SUMMARY}"; echo
    echo; echo "${ITERATIONS} file:"; cat "${ITERATIONS}"; echo
done

CAN_PLOT="yes"
for plotStab in rhiechow jst evenlap_m1
do
    if [[ "${STABS}" != "all" && ! " ${STABS} " =~ " ${plotStab} " ]]
    then
        CAN_PLOT="no"
    fi
done

if command -v gnuplot &>/dev/null && [[ "${CAN_PLOT}" == "yes" && "${START_MESH}" -le 1 && "${END_MESH}" -ge 4 ]]
then
    cp ../plotScripts/*.gnuplot .

    for f in *.gnuplot
    do
        echo "Running gnuplot on ${f}"
        gnuplot "${f}"
    done
elif command -v gnuplot &>/dev/null
then
    echo "Skipping plots for subset/partial sweep"
fi

cd ..

echo; echo; echo "Done!"; echo
echo "View the PDF files in ${RUN_DIR}"
echo; echo "Completed at $(date +%Y%m%d_%H%M%S)"
echo; echo
