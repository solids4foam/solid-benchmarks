#!/usr/bin/env bash
set -eo pipefail

# The seven ready-made meshes are stored as
# base/snes/system/blockMeshDict.1 ... blockMeshDict.7.
#
# Examples:
#   ./Allrun 3                  # run levels 1, 2 and 3
#   MESH_LEVELS="2 4" ./Allrun # run only levels 2 and 4
BASE="base/snes"
MESH_LEVELS="${MESH_LEVELS:-1}"
MAX_MESH_LEVEL=7

# Plot once every requested mesh level has finished. Prefer the active Conda
# interpreter when one is exported because its executable may not be first on
# PATH in an OpenFOAM shell.
PLOTTER="${PLOTTER:-python}"
PLOT_PYTHON="${PLOT_PYTHON:-${CONDA_PYTHON_EXE:-python3}}"

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

case "${1:-}" in
    -h|--help)
        echo "Usage: ./Allrun [number-of-mesh-levels]"
        echo "       MESH_LEVELS=\"1 3 5\" ./Allrun"
        echo "       PLOTTER=gnuplot ./Allrun 3"
        echo "Available mesh levels: 1-${MAX_MESH_LEVEL}"
        echo "PLOTTER selects the final plot script: python, gnuplot or none."
        exit 0
        ;;
    "")
        ;;
    *)
        if ! [[ "$1" =~ ^[1-7]$ ]]; then
            echo "The number of mesh levels must be an integer from 1 to ${MAX_MESH_LEVEL}." >&2
            exit 2
        fi
        MESH_LEVELS="$(seq 1 "$1")"
        ;;
esac

for mesh_level in $MESH_LEVELS; do
    if ! [[ "$mesh_level" =~ ^[1-7]$ ]]; then
        echo "Invalid mesh level '$mesh_level'; available levels are 1-${MAX_MESH_LEVEL}." >&2
        exit 2
    fi
done

if [[ -z "${WM_PROJECT_DIR:-}" ]] \
    || [[ ! -f "$WM_PROJECT_DIR/bin/tools/RunFunctions" ]]; then
    echo "OpenFOAM is not configured in this shell." >&2
    echo "Source your OpenFOAM environment before running this script." >&2
    exit 1
fi

# shellcheck source=/dev/null
source "$WM_PROJECT_DIR/bin/tools/RunFunctions"

if [[ ! -d "$ROOT/$BASE" ]]; then
    echo "Base case not found: $ROOT/$BASE" >&2
    exit 1
fi

mkdir -p "$ROOT/runs"
summary="$ROOT/runs/beam.summary.txt"
if [[ ! -f "$summary" ]]; then
    echo "# Mesh CellSize_mm Cells Dz_m MagD_m" > "$summary"
fi

for mesh_level in $MESH_LEVELS; do
    case_dir="$ROOT/runs/mesh${mesh_level}"

    if [[ -e "$case_dir" ]]; then
        echo "Run case already exists: $case_dir" >&2
        echo "Run ./Allclean before repeating that mesh level." >&2
        exit 1
    fi

    echo
    echo "Copying $BASE to runs/mesh${mesh_level}"
    cp -R "$ROOT/$BASE" "$case_dir"

    block_dict="$case_dir/system/blockMeshDict.${mesh_level}"
    if [[ ! -f "$block_dict" ]]; then
        echo "Mesh definition ${mesh_level} is missing from $ROOT/$BASE/system." >&2
        exit 1
    fi
    cp "$block_dict" "$case_dir/system/blockMeshDict"

    (
        cd "$case_dir"
        runApplication blockMesh

        echo "Running solids4Foam for mesh level ${mesh_level}"
        if [[ "${USE_MPI:-false}" == "true" ]]; then
            if ! command -v mpirun >/dev/null 2>&1; then
                echo "USE_MPI=true was requested, but mpirun is not available." >&2
                exit 1
            fi
            mpirun -np 1 solids4Foam > log.solids4Foam 2>&1
        else
            solids4Foam > log.solids4Foam 2>&1
        fi
    )

    point_file="$case_dir/postProcessing/0/solidPointDisplacement_pointDisp.dat"
    if [[ ! -f "$point_file" ]]; then
        echo "Expected tip-displacement output was not written: $point_file" >&2
        exit 1
    fi

    case "$mesh_level" in
        1) cell_size="1";           cells="10" ;;
        2) cell_size="0.5";         cells="80" ;;
        3) cell_size="0.25";        cells="640" ;;
        4) cell_size="0.125";       cells="5120" ;;
        5) cell_size="0.0625";      cells="40960" ;;
        6) cell_size="0.03125";     cells="327680" ;;
        7) cell_size="0.0138888889"; cells="3732480" ;;
    esac

    dz="$(awk 'NF && $1 !~ /^#/ {last=$4} END {print last}' "$point_file")"
    mag_d="$(awk 'NF && $1 !~ /^#/ {last=$5} END {print last}' "$point_file")"
    if [[ -z "$dz" || -z "$mag_d" ]]; then
        echo "Could not read the final displacement from $point_file" >&2
        exit 1
    fi

    printf '%s %s %s %s %s\n' \
        "$mesh_level" "$cell_size" "$cells" "$dz" "$mag_d" >> "$summary"
done

echo
echo "Completed mesh level(s): $MESH_LEVELS"
echo "Results are under $ROOT/runs."
echo "Tip-displacement summary: $summary"

# Both scripts use paths relative to the case root. Changing directory here
# makes plotting independent of the directory from which Allrun was invoked.
PYTHON_PLOT="$ROOT/plotScripts/render_land_problem1_plots.py"
GNUPLOT_PLOT="$ROOT/plotScripts/dz.gnuplot"

cd "$ROOT"

case "$PLOTTER" in
    gnuplot)
        if ! command -v gnuplot >/dev/null 2>&1; then
            echo "gnuplot not found: skipping the figure." >&2
        elif [[ ! -f "$GNUPLOT_PLOT" ]]; then
            echo "Plot script not found: $GNUPLOT_PLOT" >&2
        else
            echo
            echo "Plotting with plotScripts/$(basename "$GNUPLOT_PLOT")"
            gnuplot "$GNUPLOT_PLOT"
        fi
        ;;
    python)
        if ! command -v "$PLOT_PYTHON" >/dev/null 2>&1; then
            echo "$PLOT_PYTHON not found: skipping the figure." >&2
        elif [[ ! -f "$PYTHON_PLOT" ]]; then
            echo "Plot script not found: $PYTHON_PLOT" >&2
        else
            echo
            echo "Plotting with plotScripts/$(basename "$PYTHON_PLOT")"
            "$PLOT_PYTHON" "$PYTHON_PLOT"
        fi
        ;;
    none)
        ;;
    *)
        echo "Unknown PLOTTER '$PLOTTER'; expected python, gnuplot or none." >&2
        exit 2
        ;;
esac
