FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      f0;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform (1 0 0);

boundaryField
{
    left
    {
        type            calculated;
        value           $internalField;
    }
    right
    {
        type            calculated;
        value           $internalField;
    }
    back
    {
        type            calculated;
        value           $internalField;
    }
    front
    {
        type            calculated;
        value           $internalField;
    }
    top
    {
        type            calculated;
        value           $internalField;
    }
    bottom
    {
        type            calculated;
        value           $internalField;
    }
}

