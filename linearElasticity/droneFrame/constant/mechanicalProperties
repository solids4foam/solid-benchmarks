FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      mechanicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

planeStress     no;

mechanical
(
    ABSplus
    {
        type            linearElastic;
        rho             rho [1 -3 0 0 0 0 0] 1040;
        E               E [1 -1 -2 0 0 0 0] 2.5e9;
        nu              nu [0 0 0 0 0 0 0] 0.35;
    }
);

